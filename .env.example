# ---- MvideoERP environment template. Copy to .env and fill real values. ----
# NEVER commit the real .env. Secrets live only here / in .local-secrets.

APP_ENV=development
# SQLite zero-infra default. To use Postgres: postgresql+psycopg://user:pass@127.0.0.1:5432/mvideo_erp
# NOTE: use an ABSOLUTE path (sqlite:///C:/MvideoERP/mvideo_erp.db) so the service
# connects to the same DB regardless of the working directory it is started from.
DATABASE_URL=sqlite:///./mvideo_erp.db

# ---- M.Video traditional API (DEPRECATED for this account: 400 no key type).
#      Kept for reference only. Create in ЛК -> «Доступ к API» ----
MVIDEO_API_BASE_URL=https://api.sellers.mvideo.ru
MVIDEO_API_KEY=
MVIDEO_TIMEOUT_SECONDS=30

# ---- M.Video OMNI API (omni-net) — v0.3.1 PRIMARY WRITE CHANNEL ----
# Create a key in ЛК -> «Доступ к API» with «Omniom:» permissions
# (Просмотр/Редактирование заказов, Редактирование цен, Редактирование остатков,
#  Просмотр остатков, Просмотр цен). The key value is shown only once.
OMNI_API_BASE_URL=https://omni-net.sellers.mvideo.ru
OMNI_API_KEY=
OMNI_TIMEOUT_SECONDS=30

# ---- Ozon Seller API (read source). Reuse the credentials from C:\OzonERP\.env ----
OZON_API_BASE_URL=https://api-seller.ozon.ru
OZON_CLIENT_ID=
OZON_API_KEY=
OZON_TIMEOUT_SECONDS=30

# ---- Rate limit self-throttle ----
RL_WINDOW_SECONDS=10800
RL_MAX_REQUESTS=300
RL_BAN_SECONDS=300
RL_SAFETY_HEADROOM=0.9

# ---- External integration boundary (Ozon ERP -> M.Video ERP) ----
# Shared secret sent by the caller in X-Integration-Key. Generate a long random value.
INTEGRATION_API_KEY=

# ---- Migration defaults ----
MV_SUPPLY_SCHEME=FBS
MV_NDS=USN
POLL_INTERVAL_SECONDS=120
POLL_BATCH_SIZE=20
DEFAULT_PRICE_RUB=0
DEFAULT_STOCK=0
