@echo off
powershell -NoProfile -Command "$p='C:\Users\Administrator\Desktop\api\ozonapi.txt'; Write-Output ('exists: ' + (Test-Path $p)); if(Test-Path $p){ $lines=Get-Content $p -Encoding UTF8; Write-Output ('lines: ' + $lines.Count); for($i=0;$i -lt $lines.Count;$i++){ $s=$lines[$i].Trim(); if(-not $s){continue}; if($s.StartsWith('#')){ Write-Output ($i.ToString()+' [comment] '+$s.Substring(0,[Math]::Min(80,$s.Length))); continue }; if($s.Contains('=')){ $sp='=' } elseif($s.Contains(':')){ $sp=':' } else { Write-Output ($i.ToString()+' [no-sep] '+$s.Substring(0,[Math]::Min(80,$s.Length))); continue }; $parts=$s.Split($sp,2); $k=$parts[0].Trim(); $v=$parts[1].Trim(); if($v.Length -gt 6){$m=$v.Substring(0,4)+'...'+$v.Substring($v.Length-2)}else{$m='[short]'}; Write-Output ($i.ToString()+' '+$k+' = ['+$v.Length.ToString()+' chars] '+$m) } }"
